# nginx resmi image'ı, /etc/nginx/templates/*.template dosyalarındaki ${VAR} ifadelerini
# açılışta ortam değişkenleriyle doldurur (envsubst). Yalnızca tanımlı değişkenler değiştirilir,
# bu yüzden $host gibi nginx değişkenleri olduğu gibi kalır.
#   docker compose : API_UPSTREAM=http://gateway-service:8080 (Dockerfile varsayılanı)
#   Helm           : API_UPSTREAM=http://<release>-gateway:8080
server {
    listen 80;
    server_name _;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
