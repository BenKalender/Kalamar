@page "/tasks"
@inject HttpClient Http

<PageTitle>Tasks</PageTitle>

<h1>Tasks</h1>

<EditForm Model="newTask" OnValidSubmit="CreateTaskAsync">
    <div class="row g-2 mb-2">
        <div class="col-md-4">
            <InputText class="form-control" @bind-Value="newTask.Title" placeholder="Title" />
        </div>
        <div class="col-md-3">
            <InputText class="form-control" @bind-Value="newTask.Description" placeholder="Description" />
        </div>
        <div class="col-md-3">
            <InputSelect class="form-select" @bind-Value="newTask.UserId">
                <option value="0">-- Assign to user --</option>
                @foreach (var user in users)
                {
                    <option value="@user.Id">@user.Username (#@user.Id)</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Add Task</button>
        </div>
    </div>
</EditForm>

@if (users.Count == 0 && errorMessage is null)
{
    <div class="alert alert-warning">
        There are no users yet. <a href="/users">Create a user</a> first, then assign tasks to them.
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert @(isWarning ? "alert-warning" : "alert-danger")">@errorMessage</div>
}

@if (tasks.Count == 0)
{
    <div class="alert alert-info" role="alert">
        <strong>No tasks yet.</strong> Create your first task using the form above.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Description</th>
                <th>User</th>
                <th>Done</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var taskItem in tasks)
            {
                <tr>
                    <td>@taskItem.Id</td>
                    <td>@taskItem.Title</td>
                    <td>@taskItem.Description</td>
                    <td>@UserLabel(taskItem.UserId)</td>
                    <td>
                        <input type="checkbox" checked="@taskItem.IsCompleted" @onchange="args => ToggleCompletedAsync(taskItem, (bool?)args.Value ?? false)" />
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTaskAsync(taskItem.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private readonly List<TaskItem> tasks = [];
    private readonly List<User> users = [];
    private TaskItem newTask = new();
    private string? errorMessage;
    private bool isWarning;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadUsersAsync(), LoadTasksAsync());
    }

    private string UserLabel(int userId) =>
        users.FirstOrDefault(u => u.Id == userId) is { } user ? user.Username : $"#{userId} (deleted)";

    private async Task LoadUsersAsync()
    {
        try
        {
            var data = await Http.GetFromJsonAsync<List<User>>("api/users");
            users.Clear();
            users.AddRange(data ?? []);
        }
        catch (Exception ex)
        {
            ShowError($"Failed to load users: {ex.Message}");
        }
    }

    private async Task LoadTasksAsync()
    {
        try
        {
            var data = await Http.GetFromJsonAsync<List<TaskItem>>("api/tasks");
            tasks.Clear();
            tasks.AddRange(data ?? []);
        }
        catch (Exception ex)
        {
            ShowError($"Failed to load tasks: {ex.Message}");
        }
    }

    private async Task CreateTaskAsync()
    {
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/tasks", newTask);
            if (!await HandleFailureAsync(response, "Task could not be created"))
            {
                newTask = new TaskItem();
                await LoadTasksAsync();
            }
        }
        catch (Exception ex)
        {
            ShowError($"Failed to create task: {ex.Message}");
        }
    }

    private async Task ToggleCompletedAsync(TaskItem taskItem, bool isCompleted)
    {
        errorMessage = null;

        try
        {
            taskItem.IsCompleted = isCompleted;
            var response = await Http.PutAsJsonAsync($"api/tasks/{taskItem.Id}", taskItem);
            if (await HandleFailureAsync(response, "Task could not be updated"))
            {
                taskItem.IsCompleted = !isCompleted;
            }
        }
        catch (Exception ex)
        {
            taskItem.IsCompleted = !isCompleted;
            ShowError($"Failed to update task: {ex.Message}");
        }
    }

    private async Task DeleteTaskAsync(int id)
    {
        errorMessage = null;

        try
        {
            var response = await Http.DeleteAsync($"api/tasks/{id}");
            if (!await HandleFailureAsync(response, "Task could not be deleted"))
            {
                await LoadTasksAsync();
            }
        }
        catch (Exception ex)
        {
            ShowError($"Failed to delete task: {ex.Message}");
        }
    }

    /// <summary>Cevap başarısızsa hata mesajını gösterir ve <c>true</c> döner.</summary>
    private async Task<bool> HandleFailureAsync(HttpResponseMessage response, string action)
    {
        if (response.IsSuccessStatusCode)
        {
            return false;
        }

        var message = await ApiProblem.ReadMessageAsync(response);
        ShowError($"{action}: {message}", warning: ApiProblem.IsServiceUnavailable(response));
        return true;
    }

    private void ShowError(string message, bool warning = false)
    {
        errorMessage = message;
        isWarning = warning;
    }
}
